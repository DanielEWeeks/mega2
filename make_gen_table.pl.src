#
# make_gen_table.pl
# This generates a formatted table output for
# all loci analyzed with the GEN program
#

open(OUTFILE, ">>$ARGV[1]");
print OUTFILE "\n";
print OUTFILE 
"Marker     Alleles   Expected      Observed       P-value    Expected   Observed  #Genotypes\n";
print OUTFILE 
"                     Homozygosity  Homozygosity              Chi-sq     Chi-sq              \n";
print OUTFILE "\n";
close(OUTFILE);

format TABLEROW = 
@<<<<<<<<@>>>>>>>>@>>>>>>>>>>>>@>>>>>>>>>>>>@>>>>>>>>>>>@>>>>>>>>>>>@>>>>>>>>>>>@>>>>>>>> 
$marker, $alleles, $homo_exp, $homo_obs, $p_value, $chisq_e, $chisq_o, $num_genos
.

open(INFILE, $ARGV[0]);
open(TABLEROW, ">>$ARGV[1]") || die "can't create";

$end = 0;
while (<INFILE>) {
    if (/Marker/) {
	if ($end>0) {
	    write(TABLEROW);
	}	
	$end = 0; 
	$homo_exp=0.0;	$homo_obs=0.0;
	$alleles=0; $num_genos=0;
	$chisq_o=0.0; 	$chisq_e=0.0;
	@line_parts=split();
	$marker=$line_parts[1];
	chomp $marker;
    }
    if (/Expected homozygosity/) {
	$line = $_;
	@line_parts = split(/[:]/, $line);
	$homo_exp = $line_parts[1];
	chomp $homo_exp;
	$homo_exp=&float_format($homo_exp);
    }
    if (/Observed homozygosity/) {
	$line = $_;
	@line_parts = split(/[:]/, $line);
        $homo_obs =  $line_parts[1];
	chomp $homo_obs;
	$homo_obs=&float_format($homo_obs);
    }
    if (/Genotypes counted/) {
	$line = $_;
	@line_parts = split(/[:]/, $line);
        $num_genos =  $line_parts[1];
	chomp $num_genos;
    }
    if (/ROWS/) {
	$_ = <INFILE>; $_ = <INFILE>;
	@line_parts = split();
	$alleles =  $line_parts[2];
	chomp $alleles;
    }
    if (/OBSERVED CHI-SQUARED STATISTIC/) {
	$_= <INFILE>; 	$_= <INFILE>;
	@line_parts = split();
	$chisq_o=&float_format($line_parts[0]);
    }
    
    if (/RUN/) {
	$_ = <INFILE>; $_ = <INFILE>;
	@line_parts=split();
	$p_value=&float_format($line_parts[1]); 
	$chisq_e=$line_parts[2];
	chomp $chisq_e;
	$chisq_e=&float_format($chisq_e);
	$end = 1;
    }
}
if ($end > 0) {
    write(TABLEROW);
}

close(INFILE);
close(TABLEROW);

sub float_format

{
    $a=$_[0];
    return sprintf("%7.4f", $a);
}

