\emph on
Mega2GenABELtst
\emph default
() can be used to
\end_layout

\begin_layout Standard
compare the phenotype data, genotype data, and object metadata, item by
 item.
\end_layout

\begin_layout Standard
\begin_inset Flex Chunk
status open

\begin_layout Plain Layout

<<mega2genabeltst>>=
\end_layout

\begin_layout Plain Layout

options(max.print = 30)
\end_layout

\begin_layout Plain Layout

