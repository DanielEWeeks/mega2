	Doi = {10.1093/bioinformatics/bti364},
	Journal = {Bioinformatics},
	Journal-Full = {Bioinformatics (Oxford, England)},
	Mesh = {Chromosome Mapping; Database Management Systems; Databases, Genetic; Information Storage and Retrieval; Linkage Disequilibrium; Software; Systems Integration; User-Computer Interface},
