	Pmid = {15491493},
	Pst = {epublish},
	Title = {GeneLink: a database to facilitate genetic studies of complex traits},
	Volume = {5},
	Year = {2004},
	Bdsk-Url-1 = {http://dx.doi.org/10.1186/1471-2164-5-81}}

